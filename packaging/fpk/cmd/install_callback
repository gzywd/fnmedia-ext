#!/bin/bash
# 文件落盘后：确保依赖并安装接管服务。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
[ -n "${FNMEDIA_REPO_DIR}" ] || fnmedia_fail "应用文件缺失（deploy/install.sh 不存在）"
cd "${FNMEDIA_REPO_DIR}" || fnmedia_fail "无法进入应用目录"
if [ ! -x ".venv/bin/python" ]; then
  python3 -m venv .venv >> "${FNMEDIA_LOG}" 2>&1 || fnmedia_fail "创建 venv 失败"
  .venv/bin/pip install -q --upgrade pip >> "${FNMEDIA_LOG}" 2>&1 || true
  .venv/bin/pip install -q fastapi "uvicorn" httpx >> "${FNMEDIA_LOG}" 2>&1 || fnmedia_fail "Python 依赖安装失败"
fi
bash deploy/install.sh >> "${FNMEDIA_LOG}" 2>&1 || { tail -n 8 "${FNMEDIA_LOG}" >&2 || true; fnmedia_fail "接管服务启动失败，详见 ${FNMEDIA_LOG}"; }
exit 0
