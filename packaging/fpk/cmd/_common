#!/bin/bash
# fnmedia-ext 应用中心生命周期脚本的共享辅助（被 source）。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FNMEDIA_APP_ROOT="$(cd "${SELF_DIR}/.." && pwd)"
FNMEDIA_REPO_DIR=""
for _cand in "${TRIM_APPDEST:-}/repo" "${FNMEDIA_APP_ROOT}/target/repo" "${FNMEDIA_APP_ROOT}/repo"; do
  if [ -n "${_cand}" ] && [ -f "${_cand}/deploy/install.sh" ]; then
    FNMEDIA_REPO_DIR="$(cd "${_cand}" && pwd)"; break
  fi
done
unset _cand
FNMEDIA_LOG="${TRIM_PKGVAR:-/tmp}/fnmedia-app.log"
mkdir -p "$(dirname "${FNMEDIA_LOG}")" 2>/dev/null || true
fnmedia_fail() {
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
  echo "[fnmedia-ext] $1" >&2; exit 1
}
